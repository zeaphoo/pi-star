{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next/navigation": [
        "./src/shims/next-navigation.ts"
      ],
      "next/image": [
        "./src/shims/next-image.tsx"
      ],
      "@earendil-works/pi-ai/utils/json-parse": [
        "./src/shims/pi-json-parse.ts"
      ]
    },
    "noImplicitAny": false,
    "strictNullChecks": true
  },
  "include": [
    "src"
  ]
}